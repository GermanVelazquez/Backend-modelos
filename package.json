{
  "name": "ajedrez-backend",
  "version": "1.0.0",
  "description": "Backend Express del proyecto Ajedrez (Modelos y Simulación)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "node --watch src/dev-memory.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js"
  },
