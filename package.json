    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.7.0"
}
