# Copiar a .env y completar. NUNCA subir el .env al repositorio.

# Base de datos (obligatoria salvo STORE=memory). El valor real lo define GC (Facundo Olivera).
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:5432/postgres

# postgres (por defecto) | memory (solo desarrollo: las partidas se pierden al reiniciar)
STORE=postgres

PORT=3001
NODE_ENV=development
# Orígenes del frontend permitidos (CORS), separados por coma. Vite usa 5173; Next.js, 3000.
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Microservicio de IA (Python/FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=3000

# Stockfish: ruta al ejecutable (absoluta, o relativa a la carpeta backend/). Descarga: https://stockfishchess.org/download/
#   Windows: C:\Users\USUARIO\Escritorio\stockfish\stockfish-windows-x86-64-universal.exe
#   Linux:   /usr/games/stockfish        macOS: /opt/homebrew/bin/stockfish
STOCKFISH_PATH=./bin/stockfish.exe
STOCKFISH_TIMEOUT_MS=3000
